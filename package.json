{
  "name": "@playcanvas/supersplat-viewer",
  "version": "1.30.0",
  "author": "PlayCanvas <support@playcanvas.com>",
  "homepage": "https://github.com/playcanvas/supersplat-viewer#readme",
  "description": "Viewer for https://superspl.at",
  "keywords": [
    "playcanvas",
    "ply",
    "gaussian",
    "splat",
    "viewer"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./settings": {
      "types": "./dist/settings.d.ts",
      "import": "./dist/settings.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/playcanvas/supersplat-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/playcanvas/supersplat-viewer/issues"
  },
  "files": [
    "dist",
    "public/index.html",
    "public/index.css",
    "public/index.js",
    "public/index.js.map",
    "LICENSE",
    "package.json",
    "README.md"
  ],
  "devDependencies": {
    "@playcanvas/eslint-config": "3.0.0-beta.8",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-typescript": "12.3.0",
    "autoprefixer": "10.5.4",
    "concurrently": "9.2.4",
    "eslint": "9.39.5",
    "globals": "17.9.0",
    "playcanvas": "2.21.3",
    "postcss": "8.5.23",
    "prettier": "3.9.6",
    "publint": "0.3.23",
    "rollup": "4.62.4",
    "rollup-plugin-dts": "6.5.1",
    "rollup-plugin-scss": "4.0.1",
    "rollup-plugin-string": "3.0.0",
    "sass": "1.102.0",
    "serve": "14.2.6",
    "typescript": "5.9.3"
  },
  "scripts": {
    "build": "rollup -c",
    "develop": "concurrently --kill-others \"npm run watch\" \"npm run serve\"",
    "fmt": "prettier --check src test rollup.config.mjs eslint.config.mjs prettier.config.mjs",
    "fmt:fix": "prettier --write src test rollup.config.mjs eslint.config.mjs prettier.config.mjs",
    "lint": "eslint src test rollup.config.mjs eslint.config.mjs prettier.config.mjs",
    "lint:fix": "eslint src test rollup.config.mjs eslint.config.mjs prettier.config.mjs --fix",
    "publint": "publint",
    "serve": "serve public -C -c ../serve.json",
    "test": "npm run build && npm run test:unit",
    "test:unit": "node --test",
    "type:check": "tsc --noEmit",
    "watch": "rollup -c -w"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
